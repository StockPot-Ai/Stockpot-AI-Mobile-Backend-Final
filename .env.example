FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Supabase Configuration (Optional if USE_MOCK_DATA=true)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Optional if USE_MOCK_DATA=true)
GEMINI_API_KEY=

# Set to true to use realistic mock data when Supabase is empty or unconfigured
USE_MOCK_DATA=true

# CORS configuration (comma separated origins, or * for all during development)
CORS_ORIGINS=*
